# STAGE 1: Frontend Build (Node)
FROM node:20-alpine as frontend
WORKDIR /app
COPY package.json package-lock.json vite.config.js ./
RUN npm ci
COPY resources/ resources/
RUN npm run build 


# STAGE 2: PHP Engine
FROM php:8.4-fpm-alpine

# Install OS dependencies
RUN apk add --no-cache libpng-dev libjpeg-turbo-dev freetype-dev zip libzip-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install pdo pdo_mysql gd zip opcache

# Bring in Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer
WORKDIR /var/www

# Copy custom Opcache configuration
COPY docker/php/opcache.ini /usr/local/etc/php/conf.d/opcache.ini

# OPTIMIZATION 1: Cache dependencies! Copy only composer files first.
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-interaction --no-scripts --no-autoloader

# Now copy the rest of the application code
COPY . .

# Bring in compiled CSS/JS from Stage 1
COPY --from=frontend /app/public/build ./public/build

# Generate optimized autoloader now that the code is present
RUN composer dump-autoload --optimize

# OPTIMIZATION 2: Fix permissions before switching users
RUN chown -R www-data:www-data /var/www

# OPTIMIZATION 3: Run as a non-root user for security
USER www-data

# OPTIMIZATION 4: Cache Laravel configuration, events, and views
RUN php artisan config:cache \
    && php artisan event:cache \
    && php artisan route:cache \
    && php artisan view:cache